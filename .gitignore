# ── 只放「小笛」机器人本体；下列一律挡在外面 ──
node_modules/
.tmp/
probe/
archive/
memory/

# 机器人运行产物
qq-bot/logs/
qq-bot/stickers/
qq-bot/小笛记忆-spool/
*.log
*.dmp

# ⚠️ 密钥 / cookie / 本地配置：绝不入库
